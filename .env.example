# Shift Marketing Agency & Academy - Production Environment Variables Example
# Duplicate this file to .env on your secure production server.
# NEVER commit or expose actual secret values.

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Production Admin Authentication (Server-Side Only)
# REQUIRED: Production admin login will fail safely if these are not set.
SHIFT_ADMIN_EMAIL=admin@shiftagency.am
SHIFT_ADMIN_PASSWORD=change_this_to_a_strong_random_password_min_16_chars
SHIFT_ADMIN_SESSION_SECRET=change_this_to_a_random_crypto_secret_min_32_chars

# AI Assistant Proxy (Server-Side Only, Optional)
GEMINI_API_KEY=

# Persistent Storage Notice
# The application automatically maintains data under:
# <application_directory>/.shift-data/
# Ensure the node process has read/write permissions for this directory.
